# ============================================
# VERCEL IGNORE FILE
# ============================================
# Deploy from dist/ folder only

# Source files (don't deploy these)
/js/
/css/
/assets/

# Root HTML files (use dist/ versions instead)
/index.html
/projects.html
/submit.html
/tools.html
/dictionary.html

# Bot (runs separately on Railway)
/bot/

# Schemas and docs
/schemas/

# Worker (deployed to Cloudflare)
/worker/

# Build files
esbuild.config.js
package.json
package-lock.json
/node_modules/

# Local
*.bat
.env
.env.local
/.git/
.gitignore

# Other
*.log
.DS_Store
Thumbs.db
