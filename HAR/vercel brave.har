          "content": {
            "size": 35161,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n\n    <!-- ============================================\n         Division Zero - Home Page\n         ============================================\n         This is the main landing page.\n         \n         SECTIONS:\n         1. Hero - Main title + CTA buttons\n         2. Features - What we offer\n         3. Model - How it works\n         4. Stats - Key numbers\n         5. Join - Call to action\n         ============================================ -->\n\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"description\"\n        content=\"divisionzero - Where ideas become reality through AI. Discover vibecoding projects, tools, and resources for building with AI assistants.\">\n\n    <!-- Open Graph -->\n    <meta property=\"og:title\" content=\"divisionzero - Vibecoding Community\">\n    <meta property=\"og:description\"\n        content=\"Where ideas become reality through AI. Discover vibecoding projects and tools.\">\n    <meta property=\"og:type\" content=\"website\">\n\n    <title>divisionzero - Where Ideas Become Reality Through AI</title>\n\n    <!-- PWA -->\n    <link rel=\"manifest\" href=\"/manifest.json\">\n    <meta name=\"theme-color\" content=\"#8b5cf6\">\n    <meta name=\"mobile-web-app-capable\" content=\"yes\">\n    <link rel=\"apple-touch-icon\" href=\"/assets/images/white-logo.svg\">\n\n    <!-- Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link\n        href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap\"\n        rel=\"stylesheet\">\n\n    <!-- ========================================\n         CSS FILES\n         Load order matters! Foundation first.\n         ======================================== -->\n\n    <!-- Foundation -->\n    <!-- Layout -->\n    <!-- Components -->\n    <!-- Pods -->\n    <!-- Utils -->\n    \n    <!-- CSS Bundle -->\n    <link rel=\"stylesheet\" href=\"styles.min.css\">\n\n    <!-- SPA Page Styles -->\n    <style>\n        .spa-page { display: none; }\n        .spa-page.active { display: block; }\n    </style>\n</head>\n<body>\n    <!-- NAVIGATION (global) -->\n    <div id=\"nav-placeholder\" data-page=\"home\"></div>\n\n    <!-- SPA PAGES CONTAINER -->\n    <main id=\"spa-app\">\n\n    <!-- PAGE: HOME -->\n    <div id=\"page-home\" class=\"spa-page active\" style=\"display: block;\">\n        <!-- ========================================\n         NAVIGATION\n         Rendered by JavaScript (nav.js)\n         data-page: Sets active nav link\n         ======================================== -->\n    \n\n\n    <!-- ========================================\n         HERO SECTION\n         Main title, subtitle, CTA buttons, logo\n         ======================================== -->\n    <section class=\"hero\">\n\n        <!-- Background glow effect -->\n        <div class=\"hero-bg\" aria-hidden=\"true\"></div>\n\n        <div class=\"container\">\n            <div class=\"hero-content\">\n\n                <!-- TEXT COLUMN -->\n                <div class=\"hero-text\">\n                    <h1 class=\"hero-title\">\n                        <span class=\"gradient-text\">Vibecoding</span><br>\n                        Is Art\n                    </h1>\n                    <p class=\"hero-subtitle\">\n                        This is what happens when curiosity meets AI. Join\n                        thousands of vibecoders building what others can't imagine.\n                    </p>\n                    <div class=\"hero-cta\">\n                        <a href=\"projects.html\" class=\"btn-primary btn-large\">\n                            Explore Projects\n                            <span class=\"btn-icon\">→</span>\n                        </a>\n                        <a href=\"tools.html\" class=\"btn-secondary btn-large\">\n                            View Tools\n                        </a>\n                    </div>\n                </div>\n\n                <!-- LOGO COLUMN -->\n                <div class=\"hero-logo\">\n                    <img src=\"assets/images/white-logo.svg\" alt=\"divisionzero logo\" class=\"logo-hero\">\n                </div>\n\n            </div>\n        </div>\n\n        <!-- Scroll indicator -->\n        <div class=\"scroll-indicator\" aria-hidden=\"true\">\n            <div class=\"scroll-line\"></div>\n        </div>\n\n    </section>\n\n\n    <!-- ========================================\n         FEATURES SECTION\n         What divisionzero offers\n         ======================================== -->\n    <section class=\"section\">\n        <div class=\"container\">\n\n            <!-- Section header -->\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Start Here</span>\n                <h2 class=\"section-title\">Everything You Need to <span class=\"gradient-text\">Start Building</span></h2>\n                <p class=\"section-description\">\n                    From inspiration to deployment, we've got you covered.\n                </p>\n            </div>\n\n            <!-- Features grid -->\n            <div class=\"features-grid\">\n\n                <!-- Feature 1: Browse & Learn -->\n                <div class=\"feature-card glass\">\n                    <div class=\"feature-icon\">\n                        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                            stroke-width=\"1.5\">\n                            <path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\" />\n                            <path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\" />\n                        </svg>\n                    </div>\n                    <h3 class=\"feature-title\">Browse & Learn</h3>\n                    <p class=\"feature-description\">\n                        Explore hundreds of projects built by vibecoders. See what's possible\n                        and get inspired for your own creations.\n                    </p>\n                </div>\n\n                <!-- Feature 2: Tools Guide -->\n                <div class=\"feature-card glass\">\n                    <div class=\"feature-icon\">\n                        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                            stroke-width=\"1.5\">\n                            <circle cx=\"12\" cy=\"12\" r=\"3\" />\n                            <path\n                                d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\" />\n                        </svg>\n                    </div>\n                    <h3 class=\"feature-title\">Tools Guide</h3>\n                    <p class=\"feature-description\">\n                        Curated list of AI tools, frameworks, and platforms. Know exactly\n                        which tools to use for your project.\n                    </p>\n                </div>\n\n                <!-- Feature 3: Vibecoder's Dictionary -->\n                <div class=\"feature-card glass\">\n                    <div class=\"feature-icon\">\n                        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\n                            stroke-width=\"1.5\">\n                            <path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\" />\n                            <path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\" />\n                        </svg>\n                    </div>\n                    <h3 class=\"feature-title\">Vibecoder's Dictionary</h3>\n                    <p class=\"feature-description\">\n                        Learn the language. Every term you need to know, with AI prompts\n                        to help you implement them.\n                    </p>\n                </div>\n\n            </div>\n\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         MODEL SECTION\n         How vibecoding works\n         ======================================== -->\n    <section class=\"section section-dark\">\n        <div class=\"container\">\n\n            <!-- Section header -->\n            <div class=\"section-header\">\n                <span class=\"section-tag\">How It Works</span>\n                <h2 class=\"section-title\">Build Without <span class=\"gradient-text\">Writing Code</span></h2>\n            </div>\n\n            <!-- Model grid -->\n            <div class=\"model-grid\">\n\n                <!-- Step 1 -->\n                <div class=\"model-card glass\">\n                    <span class=\"model-number\">01</span>\n                    <h3 class=\"model-title\">Describe Your Idea</h3>\n                    <p class=\"model-description\">\n                        Tell an AI what you want to build in plain English.\n                        <strong>\"Make me a task manager with categories and due dates.\"</strong>\n                    </p>\n                </div>\n\n                <!-- Step 2 -->\n                <div class=\"model-card glass\">\n                    <span class=\"model-number\">02</span>\n                    <h3 class=\"model-title\">AI Writes the Code</h3>\n                    <p class=\"model-description\">\n                        Claude, ChatGPT, or Cursor generates working code.\n                        <strong>You iterate by describing what to change.</strong>\n                    </p>\n                </div>\n\n                <!-- Step 3 -->\n                <div class=\"model-card glass\">\n                    <span class=\"model-number\">03</span>\n                    <h3 class=\"model-title\">Deploy & Share</h3>\n                    <p class=\"model-description\">\n                        Push to Vercel or Netlify with one click.\n                        <strong>Your app is live for the world to use.</strong>\n                    </p>\n                </div>\n\n            </div>\n\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         STATS SECTION\n         Key numbers\n         ======================================== -->\n    <section class=\"section\">\n        <div class=\"container\">\n            <div class=\"stats-grid\">\n\n                <div class=\"stat-item\">\n                    <div class=\"stat-value\">∞</div>\n                    <div class=\"stat-label\">Possibilities</div>\n                </div>\n\n                <div class=\"stat-item\">\n                    <div class=\"stat-value\">0</div>\n                    <div class=\"stat-label\">Code Experience Required</div>\n                </div>\n\n                <div class=\"stat-item\">\n                    <div class=\"stat-value\">1</div>\n                    <div class=\"stat-label\">Community</div>\n                </div>\n\n            </div>\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         JOIN SECTION\n         Call to action\n         ======================================== -->\n    <section class=\"section section-dark\">\n        <div class=\"container\">\n\n            <div class=\"join-card\">\n                <img src=\"assets/images/white-logo.svg\" alt=\"divisionzero\" class=\"join-logo\">\n                <h2 class=\"join-title\">Join <span class=\"gradient-text\">divisionzero</span></h2>\n                <p class=\"join-description\">\n                    Connect with vibecoders, share your projects, get feedback,\n                    and build together. The community is waiting for you.\n                </p>\n                <div class=\"join-cta\">\n                    <a href=\"https://discord.gg/SXJS4S7jUE\" target=\"_blank\" rel=\"noopener noreferrer\"\n                        class=\"btn-primary btn-large\">\n                        Join Discord\n                        <span class=\"btn-icon\">→</span>\n                    </a>\n                </div>\n            </div>\n\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         VOCABULARY TERM ROWS\n         3 scrolling rows with tooltips\n         ======================================== -->\n    <section class=\"term-scroll-section section\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <span class=\"section-tag\">Learn the Language</span>\n                <h2 class=\"section-title\">Vibecoder <span class=\"gradient-text\">Vocabulary</span></h2>\n            </div>\n        </div>\n        <div class=\"term-scroll-container\" id=\"term-scroll-container\">\n            <!-- Term rows rendered by JS -->\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         STACK LOGO LOOP\n         Infinite scrolling tool icons (decorative)\n         ======================================== -->\n    <section class=\"logo-scroll-section\">\n        <div class=\"container\">\n            <div class=\"section-header\" style=\"text-align: center;\">\n                <p class=\"section-description\" style=\"margin-bottom: 0;\">\n                    Built with the tools you love\n                </p>\n            </div>\n        </div>\n        <div class=\"logo-scroll-wrapper\">\n            <div class=\"logo-scroll-track\" id=\"logo-scroll-track\">\n                <!-- Logos rendered by JS -->\n            </div>\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         FOOTER\n         Rendered by JavaScript (footer.js)\n         ======================================== -->\n    \n\n\n    <!-- ========================================\n         JAVASCRIPT FILES\n         Load order: config → utils → components → pods → pages\n         ======================================== -->\n\n    <!-- Config & Utilities -->\n    \n    \n\n    <!-- Components -->\n    \n    \n\n    <!-- Pods -->\n    \n\n    <!-- Page Script -->\n    \n\n    <!-- Mobile Spotlight -->\n    </div>\n\n    <!-- PAGE: PROJECTS -->\n    <div id=\"page-projects\" class=\"spa-page \" style=\"display: none;\">\n        <!-- NAVIGATION -->\n    \n\n\n    <!-- ========================================\n         HERO SECTION\n         ======================================== -->\n    <section class=\"projects-hero\">\n        <div class=\"container\">\n            <div class=\"projects-header\">\n                <h1 class=\"projects-title\">\n                    <span class=\"gradient-text\">Vibecoding</span> Projects\n                </h1>\n                <p class=\"projects-subtitle\">\n                    Discover apps built by vibecoders using AI. Get inspired, learn from others,\n                    and share your own creations.\n                </p>\n                <a href=\"#\" id=\"full-projects-link\" class=\"hero-external-link\">\n                    For more projects →\n                </a>\n            </div>\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         SEARCH & FILTERS\n         ======================================== -->\n    <section class=\"section\" style=\"padding-top: 0;\">\n        <div class=\"container\">\n\n            <!-- Search input -->\n            <div class=\"dictionary-controls\">\n                <input type=\"text\" id=\"project-search\" class=\"search-input\"\n                    placeholder=\"Search projects by name, description, or tech...\">\n            </div>\n\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         PROJECTS CONTAINER\n         Categories and carousels rendered here by JS\n         ======================================== -->\n    <section class=\"section\" style=\"padding-top: 0;\">\n        <div class=\"container-lg\" id=\"projects-container\">\n            <!-- Carousels inserted by projects.js -->\n        </div>\n    </section>\n\n\n    <!-- FOOTER -->\n    \n\n\n    <!-- JavaScript Files -->\n    \n    \n    \n    \n    \n    \n    \n    \n\n    <!-- Set external link from config -->\n    \n\n    <!-- Mobile Spotlight -->\n    </div>\n\n    <!-- PAGE: TOOLS -->\n    <div id=\"page-tools\" class=\"spa-page \" style=\"display: none;\">\n        <!-- NAVIGATION -->\n    \n\n\n    <!-- ========================================\n         HERO SECTION\n         ======================================== -->\n    <section class=\"tools-hero\">\n        <div class=\"container\">\n            <div class=\"tools-header-content\">\n                <h1 class=\"tools-main-title\">\n                    The <span class=\"gradient-text\">Vibecoder's</span> Toolkit\n                </h1>\n                <p class=\"tools-subtitle\">\n                    Everything you need to build apps without writing code.\n                    From AI assistants to deployment platforms.\n                </p>\n            </div>\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         TOOLS CONTAINER\n         Categories and cards rendered here by JS\n         ======================================== -->\n    <section class=\"section\" style=\"padding-top: 0;\">\n        <div class=\"container\" id=\"tools-container\">\n            <!-- Tool categories inserted by tools.js -->\n        </div>\n    </section>\n\n\n    <!-- FOOTER -->\n    \n\n\n    <!-- JavaScript Files -->\n    \n    \n    \n    \n    \n    \n\n    <!-- Mobile Spotlight -->\n    </div>\n\n    <!-- PAGE: DICTIONARY -->\n    <div id=\"page-dictionary\" class=\"spa-page \" style=\"display: none;\">\n        <!-- NAVIGATION -->\n    \n\n\n    <!-- ========================================\n         HERO SECTION\n         ======================================== -->\n    <section class=\"dictionary-hero\">\n        <div class=\"container\">\n            <div class=\"section-header\">\n                <h1 class=\"section-title\">\n                    <span class=\"gradient-text\">Vibecoder's</span> Dictionary\n                </h1>\n                <p class=\"section-description\">\n                    Learn the language of modern web development.\n                    Every term comes with an AI prompt to help you implement it.\n                </p>\n                <a href=\"#\" id=\"full-library-link\" class=\"hero-external-link\">\n                    Our library →\n                </a>\n            </div>\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         SEARCH\n         ======================================== -->\n    <section class=\"section\" style=\"padding-top: 0;\">\n        <div class=\"container\">\n            <div class=\"dictionary-controls\">\n                <input type=\"text\" id=\"term-search\" class=\"search-input\" placeholder=\"Search terms...\">\n            </div>\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         TERMS CONTAINER\n         Cards rendered here by JS\n         ======================================== -->\n    <section class=\"section\" style=\"padding-top: 0;\">\n        <div class=\"container\" id=\"terms-container\">\n            <!-- Term cards inserted by dictionary.js -->\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         TERM MODAL\n         Opened when clicking a term card\n         ======================================== -->\n    <div class=\"modal term-modal\" id=\"term-modal\">\n        <div class=\"modal-backdrop\"></div>\n        <div class=\"modal-content glass\">\n            <!-- Content inserted by dictionary.js -->\n        </div>\n    </div>\n\n\n    <!-- FOOTER -->\n    \n\n\n    <!-- JavaScript Files -->\n    \n    \n    \n    \n    \n    \n\n    <!-- Set external link from config -->\n    \n\n    <!-- Mobile Spotlight -->\n    </div>\n\n    <!-- PAGE: SUBMIT -->\n    <div id=\"page-submit\" class=\"spa-page \" style=\"display: none;\">\n        <!-- NAVIGATION -->\n    \n\n\n    <!-- ========================================\n         HERO SECTION\n         ======================================== -->\n    <section class=\"submit-hero\">\n        <div class=\"container\">\n            <div class=\"submit-header\">\n                <h1 class=\"submit-title\">\n                    Share Your <span class=\"gradient-text\">Creation</span>\n                </h1>\n                <p class=\"submit-subtitle\">\n                    Built something cool? Have an idea for the community?\n                    We'd love to hear from you.\n                </p>\n            </div>\n        </div>\n    </section>\n\n\n    <!-- ========================================\n         FORM SECTION\n         ======================================== -->\n    <section class=\"section\" style=\"padding-top: 0;\">\n        <div class=\"container\">\n            <div class=\"form-container\">\n\n                <!-- FORM TOGGLE -->\n                <div class=\"form-toggle\">\n                    <button type=\"button\" class=\"toggle-btn active\" data-form=\"project\">\n                        Submit Project\n                    </button>\n                    <button type=\"button\" class=\"toggle-btn\" data-form=\"idea\">\n                        Submit Idea\n                    </button>\n                </div>\n\n\n                <!-- ========================================\n                     PROJECT FORM\n                     ======================================== -->\n                <form id=\"project-form\" class=\"form-card glass\">\n\n                    <div class=\"form-header\">\n                        <h2>Submit Your Project</h2>\n                        <p>Share your vibecoding creation with the community</p>\n                    </div>\n\n                    <!-- BASIC INFO SECTION -->\n                    <div class=\"form-section\">\n                        <h3 class=\"form-section-title\">Basic Information</h3>\n\n                        <div class=\"form-row\">\n                            <div class=\"form-group\">\n                                <label for=\"project-name\">Project Name *</label>\n                                <input type=\"text\" id=\"project-name\" name=\"name\" required maxlength=\"20\"\n                                    placeholder=\"e.g., TaskFlow Pro\">\n                            </div>\n\n                            <div class=\"form-group\">\n                                <label for=\"project-url\">Live URL *</label>\n                                <input type=\"url\" id=\"project-url\" name=\"url\" required\n                                    placeholder=\"https://your-app.vercel.app\">\n                            </div>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"project-description\">Description *</label>\n                            <textarea id=\"project-description\" name=\"description\" required maxlength=\"90\"\n                                placeholder=\"What does your project do? What problem does it solve?\"></textarea>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"project-logo\">Logo (ImgBB HTML) *</label><textarea id=\"project-logo\" name=\"logo\" required rows=\"2\" placeholder=\"Paste full HTML from ImgBB: <a href=...><img src=...></a>\"></textarea><span class=\"form-hint\">Upload to imgbb.com ? Copy \"HTML full linked\" ? Paste here</span>\n                        </div>\n                    </div>\n                    <!-- BUILDER INFO ROW -->\n                    <div class=\"form-row\">\n                        <div class=\"form-group\">\n                            <label for=\"builder-name\">Your Username / Handle *</label>\n                            <input type=\"text\" id=\"builder-name\" name=\"builderName\" required placeholder=\"vibecoder1\">\n                            <span class=\"form-hint\">This will show as @username on your project card</span>\n                        </div>\n                    </div>\n                    <!-- LINKS SECTION -->\n                    <div class=\"form-section\">\n                        <h3 class=\"form-section-title\">Links (Optional)</h3>\n\n                        <div class=\"form-row\">\n                            <div class=\"form-group\">\n                                <label for=\"project-github\">GitHub Repository</label>\n                                <input type=\"url\" id=\"project-github\" name=\"github\"\n                                    placeholder=\"https://github.com/you/repo\">\n                            </div>\n\n                            <div class=\"form-group\">\n                                <label for=\"project-discord\">Your Discord Username</label>\n                                <input type=\"text\" id=\"project-discord\" name=\"discord\"\n                                    placeholder=\"username#1234 or @username\">\n                            </div>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"project-profile\">Personal Profile URL</label>\n                            <input type=\"url\" id=\"project-profile\" name=\"profileUrl\"\n                                placeholder=\"https://linkedin.com/in/yourname or https://yourwebsite.com\">\n                            <span class=\"form-hint\">LinkedIn, personal website, or portfolio link</span>\n                        </div>\n                    </div>\n\n                    <!-- TECH SECTION -->\n                    <div class=\"form-section\">\n                        <h3 class=\"form-section-title\">Technology</h3>\n\n                        <div class=\"form-group\">\n                            <label>AI Tools Used</label>\n                            <div class=\"tile-grid\" data-max-select=\"5\" data-input-name=\"tools\">\n                                <div class=\"tile\" data-value=\"Claude\">Claude</div>\n                                <div class=\"tile\" data-value=\"ChatGPT\">ChatGPT</div>\n                                <div class=\"tile\" data-value=\"Gemini\">Gemini</div>\n                                <div class=\"tile\" data-value=\"Cursor\">Cursor</div>\n                                <div class=\"tile\" data-value=\"v0.dev\">v0.dev</div>\n                                <div class=\"tile\" data-value=\"Bolt.new\">Bolt.new</div>\n                                <div class=\"tile\" data-value=\"Lovable\">Lovable</div>\n                                <div class=\"tile\" data-value=\"Replit\">Replit</div>\n                            </div>\n                            <input type=\"hidden\" name=\"tools\" value=\"\">\n                            <span class=\"form-hint\">Select up to 5</span>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label>Tech Stack</label>\n                            <div class=\"tile-grid\" data-max-select=\"5\" data-input-name=\"tags\">\n                                <div class=\"tile\" data-value=\"React\">React</div>\n                                <div class=\"tile\" data-value=\"Next.js\">Next.js</div>\n                                <div class=\"tile\" data-value=\"Vue.js\">Vue.js</div>\n                                <div class=\"tile\" data-value=\"TypeScript\">TypeScript</div>\n                                <div class=\"tile\" data-value=\"JavaScript\">JavaScript</div>\n                                <div class=\"tile\" data-value=\"Node.js\">Node.js</div>\n                                <div class=\"tile\" data-value=\"Python\">Python</div>\n                                <div class=\"tile\" data-value=\"Supabase\">Supabase</div>\n                                <div class=\"tile\" data-value=\"Firebase\">Firebase</div>\n                                <div class=\"tile\" data-value=\"MongoDB\">MongoDB</div>\n                                <div class=\"tile\" data-value=\"PostgreSQL\">PostgreSQL</div>\n                                <div class=\"tile\" data-value=\"TailwindCSS\">TailwindCSS</div>\n                            </div>\n                            <input type=\"hidden\" name=\"tags\" value=\"\">\n                            <span class=\"form-hint\">Select up to 5</span>\n                        </div>\n\n                        <div class=\"form-group\">\n                            <label for=\"project-category\">Category *</label>\n                            <select id=\"project-category\" name=\"category\" required>\n                                <option value=\"\">Select a category</option>\n                                <option value=\"Productivity\">Productivity</option>\n                                <option value=\"Developer Tools\">Developer Tools</option>\n                                <option value=\"Design\">Design</option>\n                                <option value=\"Games\">Games</option>\n                                <option value=\"AI Agents\">AI Agents</option>\n                                <option value=\"Utilities\">Utilities</option>\n                                <option value=\"Other\">Other</option>\n                            </select>\n                        </div>\n                    </div>\n                    <!-- PRICING MODEL -->\n                    <div class=\"form-group\">\n                        <label for=\"project-pricing\">Pricing Model *</label>\n                        <select id=\"project-pricing\" name=\"pricingModel\" required>\n                            <option value=\"\">Select pricing model</option>\n                            <option value=\"free\">Completely Free (all tools have free tier)</option>\n                            <option value=\"partial\">Partially Paid (mix of free and paid tools)</option>\n                            <option value=\"paid\">Fully Paid (no free tier available)</option>\n                        </select>\n                        <span class=\"form-hint\">This helps users know if they need paid subscriptions to recreate\n                            this</span>\n                    </div>\n\n                    <!-- SUBMIT -->\n                    <button type=\"submit\" class=\"btn-submit\">\n                        Submit Project\n                    </button>\n\n                </form>\n\n\n                <!-- ========================================\n                     IDEA FORM\n                     ======================================== -->\n                <form id=\"idea-form\" class=\"form-card glass hidden\">\n\n                    <div class=\"form-header\">\n                        <h2>Submit an Idea</h2>\n                        <p>Got an idea for the community? Let us know!</p>\n                    </div>\n\n                    <div class=\"form-section\">\n\n                        <!-- Contact Information -->\n                        <div class=\"form-row\">\n                            <div class=\"form-group\">\n                                <label for=\"idea-name\">Your Name *</label>\n                                <input type=\"text\" id=\"idea-name\" name=\"name\" required placeholder=\"John Doe\">\n                            </div>\n\n                            <div class=\"form-group\">\n                                <label for=\"idea-email\">Email *</label>\n                                <input type=\"email\" id=\"idea-email\" name=\"email\" required\n                                    placeholder=\"john@example.com\">\n                                <span class=\"form-hint\">We'll use this to contact you</span>\n                            </div>\n                        </div>\n\n                        <!-- Idea Title -->\n                        <div class=\"form-group\">\n                            <label for=\"idea-title\">Idea Title *</label>\n                            <input type=\"text\" id=\"idea-title\" name=\"title\" required\n                                placeholder=\"e.g., AI-powered task manager\">\n                        </div>\n\n                        <!-- Category -->\n                        <div class=\"form-group\">\n                            <label for=\"idea-category\">Category</label>\n                            <select id=\"idea-category\" name=\"category\">\n                                <option value=\"\">Select category</option>\n                                <option value=\"app\">App</option>\n                                <option value=\"game\">Game</option>\n                                <option value=\"tool\">Tool</option>\n                                <option value=\"website\">Website</option>\n                                <option value=\"extension\">Extension</option>\n                                <option value=\"bot\">Bot</option>\n                                <option value=\"other\">Other</option>\n                            </select>\n                        </div>\n\n                        <!-- Docs Link -->\n                        <div class=\"form-group\">\n                            <label for=\"idea-docs\">Idea Document Link *</label>\n                            <input type=\"url\" id=\"idea-docs\" name=\"docsLink\" required\n                                placeholder=\"https://docs.google.com/document/d/...\">\n                            <span class=\"form-hint\">Paste your Google Docs, Notion, or any document link with your idea\n                                details</span>\n                        </div>\n\n                        <!-- Purpose -->\n                        <div class=\"form-group\">\n                            <label for=\"idea-purpose\">Purpose of Submission *</label>\n                            <select id=\"idea-purpose\" name=\"purpose\" required>\n                                <option value=\"\">Select purpose</option>\n                                <option value=\"validation\">Just for Validation / Feedback</option>\n                                <option value=\"client\">I'm a Client (Looking to build this)</option>\n                            </select>\n                        </div>\n\n                        <!-- Budget (shown only when purpose is \"client\") -->\n                        <div class=\"form-group budget-group hidden\">\n                            <label for=\"idea-budget\">Budget (USD) *</label>\n                            <div class=\"budget-input-wrapper\">\n                                <span class=\"budget-currency\">$</span>\n                                <input type=\"number\" id=\"idea-budget\" name=\"budget\" min=\"0\"\n                                    placeholder=\"Enter your budget\">\n                            </div>\n                            <span class=\"form-hint\">Your approximate budget for this project</span>\n                        </div>\n\n                    </div>\n\n                    <button type=\"submit\" class=\"btn-submit\">\n                        Submit Idea\n                    </button>\n\n                </form>\n\n            </div>\n        </div>\n    </section>\n\n\n    <!-- FOOTER -->\n    \n\n\n    <!-- JavaScript Files -->\n    \n    \n    \n    \n    \n    \n    \n    \n    \n\n    <!-- Mobile Spotlight -->\n    </div>\n\n    </main>\n\n    <!-- FOOTER (global) -->\n    <div id=\"footer-placeholder\"></div>\n\n    <!-- JS Bundle -->\n    <script src=\"app.min.js\"></script>\n\n    <!-- Service Worker -->\n    <script>\n        if ('serviceWorker' in navigator) {\n            window.addEventListener('load', () => {\n                navigator.serviceWorker.register('/sw.js')\n                    .then(reg => console.log('SW registered'))\n                    .catch(err => console.log('SW error:', err));\n            });\n        }\n    </script>\n</body>\n</html>"
