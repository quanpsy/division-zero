          "content": {
            "size": 12756,
            "mimeType": "application/json",
            "text": "{\n    \"_description\": \"Curated vibecoding toolkit - minimal, focused, easy to difficult path\",\n    \"_last_updated\": \"2024-12-11\",\n    \"_note\": \"No number 7 allowed! (the division zero pun)\",\n    \"_rating_system\": {\n        \"difficulty\": \"1-10 (1 = easiest, 10 = hardest). NO 7!\",\n        \"capability\": \"1-10 (1 = small projects, 10 = enterprise). NO 7!\"\n    },\n    \"ai_chatbots\": {\n        \"_order\": \"Easy to Advanced\",\n        \"tools\": [\n            {\n                \"id\": \"chatgpt\",\n                \"name\": \"ChatGPT\",\n                \"icon\": \"https://upload.wikimedia.org/wikipedia/commons/0/04/ChatGPT_logo.svg\",\n                \"website\": \"https://chat.openai.com\",\n                \"difficulty\": 1,\n                \"capability\": 6,\n                \"description\": \"Most beginner-friendly AI. Great starting point for vibecoding.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"gemini\",\n                \"name\": \"Gemini\",\n                \"icon\": \"https://cdn.jsdelivr.net/npm/simple-icons@11/icons/googlegemini.svg\",\n                \"website\": \"https://gemini.google.com\",\n                \"difficulty\": 2,\n                \"capability\": 8,\n                \"description\": \"Google's AI. Fast, good with large codebases.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"claude\",\n                \"name\": \"Claude\",\n                \"icon\": \"https://cdn.jsdelivr.net/npm/simple-icons@11/icons/anthropic.svg\",\n                \"website\": \"https://claude.ai\",\n                \"difficulty\": 3,\n                \"capability\": 10,\n                \"description\": \"Best for complex projects. Understands full architectures.\",\n                \"free_tier\": true\n            }\n        ]\n    },\n    \"code_editors\": {\n        \"_order\": \"Recommended first\",\n        \"tools\": [\n            {\n                \"id\": \"antigravity\",\n                \"name\": \"Antigravity\",\n                \"icon\": \"https://cdn.jsdelivr.net/npm/simple-icons@11/icons/google.svg\",\n                \"website\": \"https://antigravity.dev\",\n                \"difficulty\": 4,\n                \"capability\": 10,\n                \"description\": \"AI-native IDE. The future of coding. Our top pick.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"cursor\",\n                \"name\": \"Cursor\",\n                \"icon\": \"https://cdn.simpleicons.org/cursor/ffffff\",\n                \"website\": \"https://cursor.sh\",\n                \"difficulty\": 3,\n                \"capability\": 9,\n                \"description\": \"VS Code fork with AI superpowers. Very popular.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"windsurf\",\n                \"name\": \"Windsurf\",\n                \"icon\": \"https://cdn.jsdelivr.net/npm/simple-icons@11/icons/codeium.svg\",\n                \"website\": \"https://codeium.com/windsurf\",\n                \"difficulty\": 3,\n                \"capability\": 8,\n                \"description\": \"Free AI IDE by Codeium. Great Cursor alternative.\",\n                \"free_tier\": true\n            }\n        ]\n    },\n    \"no_code_builders\": {\n        \"_order\": \"Recommended path\",\n        \"tools\": [\n            {\n                \"id\": \"google-ai-studio\",\n                \"name\": \"Google AI Studio\",\n                \"icon\": \"https://cdn.jsdelivr.net/npm/simple-icons@11/icons/googlegemini.svg\",\n                \"website\": \"https://aistudio.google.com\",\n                \"difficulty\": 1,\n                \"capability\": 6,\n                \"description\": \"Surprisingly powerful AND easy. Best starting point for no-coders.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"v0\",\n                \"name\": \"v0.dev\",\n                \"icon\": \"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vercel/vercel-original.svg\",\n                \"website\": \"https://v0.dev\",\n                \"difficulty\": 2,\n                \"capability\": 6,\n                \"description\": \"Generate React components with prompts. By Vercel.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"bolt-new\",\n                \"name\": \"Bolt.new\",\n                \"icon\": \"https://cdn.jsdelivr.net/npm/simple-icons@11/icons/stackblitz.svg\",\n                \"website\": \"https://bolt.new\",\n                \"difficulty\": 2,\n                \"capability\": 8,\n                \"description\": \"Full-stack app generator. Very fast results.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"lovable\",\n                \"name\": \"Lovable\",\n                \"icon\": \"https://lovable.dev/favicon.ico\",\n                \"website\": \"https://lovable.dev\",\n                \"difficulty\": 2,\n                \"capability\": 8,\n                \"description\": \"AI app builder. Clean, modern outputs.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"base44\",\n                \"name\": \"Base44\",\n                \"icon\": \"https://base44.com/favicon.ico\",\n                \"website\": \"https://base44.com\",\n                \"difficulty\": 3,\n                \"capability\": 8,\n                \"description\": \"Build full apps without code. Great for MVPs.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"replit\",\n                \"name\": \"Replit\",\n                \"icon\": \"https://cdn.jsdelivr.net/npm/simple-icons@11/icons/replit.svg\",\n                \"website\": \"https://replit.com\",\n                \"difficulty\": 2,\n                \"capability\": 8,\n                \"description\": \"Browser-based IDE. Code, run, deploy from anywhere. AI agent built-in.\",\n                \"free_tier\": true\n            }\n        ]\n    },\n    \"frontend\": {\n        \"_order\": \"Learn these in order\",\n        \"tools\": [\n            {\n                \"id\": \"react\",\n                \"name\": \"React\",\n                \"icon\": \"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg\",\n                \"website\": \"https://react.dev\",\n                \"difficulty\": 4,\n                \"capability\": 9,\n                \"description\": \"The most popular frontend library. Learn this first.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"nextjs\",\n                \"name\": \"Next.js\",\n                \"icon\": \"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nextjs/nextjs-original.svg\",\n                \"website\": \"https://nextjs.org\",\n                \"difficulty\": 5,\n                \"capability\": 10,\n                \"description\": \"React framework with everything built-in. Production ready.\",\n                \"free_tier\": true\n            }\n        ]\n    },\n    \"backend\": {\n        \"_order\": \"Pick one based on preference\",\n        \"tools\": [\n            {\n                \"id\": \"nodejs\",\n                \"name\": \"Node.js\",\n                \"icon\": \"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg\",\n                \"website\": \"https://nodejs.org\",\n                \"difficulty\": 4,\n                \"capability\": 10,\n                \"description\": \"JavaScript on the server. Same language front and back.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"fastapi\",\n                \"name\": \"FastAPI\",\n                \"icon\": \"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/fastapi/fastapi-original.svg\",\n                \"website\": \"https://fastapi.tiangolo.com\",\n                \"difficulty\": 5,\n                \"capability\": 9,\n                \"description\": \"Python API framework. Super fast, great docs.\",\n                \"free_tier\": true\n            }\n        ]\n    },\n    \"database\": {\n        \"_note\": \"No-code friendly databases\",\n        \"tools\": [\n            {\n                \"id\": \"supabase\",\n                \"name\": \"Supabase\",\n                \"icon\": \"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/supabase/supabase-original.svg\",\n                \"website\": \"https://supabase.com\",\n                \"difficulty\": 2,\n                \"capability\": 9,\n                \"description\": \"Firebase alternative. Free tier is amazing. Even no-coders can use it!\",\n                \"free_tier\": true,\n                \"no_code_friendly\": true\n            },\n            {\n                \"id\": \"firebase\",\n                \"name\": \"Firebase\",\n                \"icon\": \"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/firebase/firebase-original.svg\",\n                \"website\": \"https://firebase.google.com\",\n                \"difficulty\": 3,\n                \"capability\": 9,\n                \"description\": \"Google's backend platform. Great for real-time apps.\",\n                \"free_tier\": true,\n                \"no_code_friendly\": true\n            }\n        ]\n    },\n    \"hosting\": {\n        \"_note\": \"Keep it simple\",\n        \"tools\": [\n            {\n                \"id\": \"vercel\",\n                \"name\": \"Vercel\",\n                \"icon\": \"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vercel/vercel-original.svg\",\n                \"website\": \"https://vercel.com\",\n                \"difficulty\": 1,\n                \"capability\": 10,\n                \"description\": \"One-click deploy. Best for Next.js. Free tier is generous.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"netlify\",\n                \"name\": \"Netlify\",\n                \"icon\": \"https://cdn.jsdelivr.net/npm/simple-icons@11/icons/netlify.svg\",\n                \"website\": \"https://netlify.com\",\n                \"difficulty\": 1,\n                \"capability\": 9,\n                \"description\": \"Drag and drop deploy. Perfect for static sites.\",\n                \"free_tier\": true\n            }\n        ]\n    },\n    \"design\": {\n        \"_note\": \"AI-powered design tools\",\n        \"tools\": [\n            {\n                \"id\": \"midjourney\",\n                \"name\": \"Midjourney\",\n                \"icon\": \"https://i.ibb.co/Mk7m8W9t/61396273.png\",\n                \"website\": \"https://midjourney.com\",\n                \"difficulty\": 2,\n                \"capability\": 9,\n                \"description\": \"Best AI image generator. Stunning visuals.\",\n                \"free_tier\": false\n            },\n            {\n                \"id\": \"dalle\",\n                \"name\": \"DALL-E\",\n                \"icon\": \"https://upload.wikimedia.org/wikipedia/commons/0/04/ChatGPT_logo.svg\",\n                \"website\": \"https://openai.com/dall-e-3\",\n                \"difficulty\": 1,\n                \"capability\": 8,\n                \"description\": \"OpenAI's image generator. Built into ChatGPT.\",\n                \"free_tier\": true\n            }\n        ]\n    },\n    \"utilities\": {\n        \"_note\": \"Essential developer tools\",\n        \"tools\": [\n            {\n                \"id\": \"github\",\n                \"name\": \"GitHub\",\n                \"icon\": \"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg\",\n                \"website\": \"https://github.com\",\n                \"difficulty\": 3,\n                \"capability\": 10,\n                \"description\": \"Code hosting. Essential for version control and collaboration.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"notion\",\n                \"name\": \"Notion\",\n                \"icon\": \"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/notion/notion-original.svg\",\n                \"website\": \"https://notion.so\",\n                \"difficulty\": 1,\n                \"capability\": 6,\n                \"description\": \"Docs, notes, project management. All-in-one workspace.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"postman\",\n                \"name\": \"Postman\",\n                \"icon\": \"https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postman/postman-original.svg\",\n                \"website\": \"https://postman.com\",\n                \"difficulty\": 3,\n                \"capability\": 8,\n                \"description\": \"API testing tool. Debug your backend easily.\",\n                \"free_tier\": true\n            },\n            {\n                \"id\": \"linear\",\n                \"name\": \"Linear\",\n                \"icon\": \"https://linear.app/favicon.ico\",\n                \"website\": \"https://linear.app\",\n                \"difficulty\": 2,\n                \"capability\": 8,\n                \"description\": \"Modern issue tracking. Beautiful and fast.\",\n                \"free_tier\": true\n            }\n        ]\n    },\n    \"_summary\": {\n        \"total_tools\": 23,\n        \"categories\": 9,\n        \"philosophy\": \"Less is more. Curated path from easy to advanced.\",\n        \"no_seven_rule\": \"No difficulty or capability = 7. Division Zero pun!\"\n    }\n}"
          },
