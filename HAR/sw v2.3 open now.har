          "content": {
            "size": 36074,
            "mimeType": "text/html",
            "compression": 29222,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n\r\n    <!-- ============================================\r\n         Division Zero - Home Page\r\n         ============================================\r\n         This is the main landing page.\r\n         \r\n         SECTIONS:\r\n         1. Hero - Main title + CTA buttons\r\n         2. Features - What we offer\r\n         3. Model - How it works\r\n         4. Stats - Key numbers\r\n         5. Join - Call to action\r\n         ============================================ -->\r\n\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <meta name=\"description\"\r\n        content=\"divisionzero - Where ideas become reality through AI. Discover vibecoding projects, tools, and resources for building with AI assistants.\">\r\n\r\n    <!-- Open Graph -->\r\n    <meta property=\"og:title\" content=\"divisionzero - Vibecoding Community\">\r\n    <meta property=\"og:description\"\r\n        content=\"Where ideas become reality through AI. Discover vibecoding projects and tools.\">\r\n    <meta property=\"og:type\" content=\"website\">\r\n\r\n    <title>divisionzero - Where Ideas Become Reality Through AI</title>\n\n    <!-- Favicon -->\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/favicon.svg\">\n\n    <!-- PWA -->\n    <link rel=\"manifest\" href=\"/manifest.json\">\n    <meta name=\"theme-color\" content=\"#8b5cf6\">\n    <meta name=\"mobile-web-app-capable\" content=\"yes\">\n    <link rel=\"apple-touch-icon\" href=\"/assets/images/white-logo.svg\">\r\n\r\n    <!-- Fonts -->\r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n    <link\r\n        href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap\"\r\n        rel=\"stylesheet\">\r\n\r\n    <!-- ========================================\r\n         CSS FILES\r\n         Load order matters! Foundation first.\r\n         ======================================== -->\r\n\r\n    <!-- Foundation -->\r\n    <!-- Layout -->\r\n    <!-- Components -->\r\n    <!-- Pods -->\r\n    <!-- Utils -->\r\n    \n    <!-- CSS Bundle -->\n    <link rel=\"stylesheet\" href=\"styles.min.css\">\n\n    <!-- SPA Page Styles -->\n    <style>\n        .spa-page { display: none; }\n        .spa-page.active { display: block; }\n    </style>\n</head>\n<body>\n    <!-- NAVIGATION (global) -->\n    <div id=\"nav-placeholder\" data-page=\"home\"></div>\n\n    <!-- SPA PAGES CONTAINER -->\n    <main id=\"spa-app\">\n\n    <!-- PAGE: HOME -->\n    <div id=\"page-home\" class=\"spa-page active\" style=\"display: block;\">\n        <!-- ========================================\r\n         NAVIGATION\r\n         Rendered by JavaScript (nav.js)\r\n         data-page: Sets active nav link\r\n         ======================================== -->\r\n    \r\n\r\n\r\n    <!-- ========================================\r\n         HERO SECTION\r\n         Main title, subtitle, CTA buttons, logo\r\n         ======================================== -->\r\n    <section class=\"hero\">\r\n\r\n        <!-- Background glow effect -->\r\n        <div class=\"hero-bg\" aria-hidden=\"true\"></div>\r\n\r\n        <div class=\"container\">\r\n            <div class=\"hero-content\">\r\n\r\n                <!-- TEXT COLUMN -->\r\n                <div class=\"hero-text\">\r\n                    <h1 class=\"hero-title\">\r\n                        <span class=\"gradient-text\">Vibecoding</span><br>\r\n                        Is Art\r\n                    </h1>\r\n                    <p class=\"hero-subtitle\">\r\n                        This is what happens when curiosity meets AI. Join\r\n                        thousands of vibecoders building what others can't imagine.\r\n                    </p>\r\n                    <div class=\"hero-cta\">\r\n                        <a href=\"projects.html\" class=\"btn-primary btn-large\">\r\n                            Explore Projects\r\n                            <span class=\"btn-icon\">→</span>\r\n                        </a>\r\n                        <a href=\"tools.html\" class=\"btn-secondary btn-large\">\r\n                            View Tools\r\n                        </a>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- LOGO COLUMN -->\r\n                <div class=\"hero-logo\">\r\n                    <img src=\"assets/images/white-logo.svg\" alt=\"divisionzero logo\" class=\"logo-hero\">\r\n                </div>\r\n\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Scroll indicator -->\r\n        <div class=\"scroll-indicator\" aria-hidden=\"true\">\r\n            <div class=\"scroll-line\"></div>\r\n        </div>\r\n\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         FEATURES SECTION\r\n         What divisionzero offers\r\n         ======================================== -->\r\n    <section class=\"section\">\r\n        <div class=\"container\">\r\n\r\n            <!-- Section header -->\r\n            <div class=\"section-header\">\r\n                <span class=\"section-tag\">Start Here</span>\r\n                <h2 class=\"section-title\">Everything You Need to <span class=\"gradient-text\">Start Building</span></h2>\r\n                <p class=\"section-description\">\r\n                    From inspiration to deployment, we've got you covered.\r\n                </p>\r\n            </div>\r\n\r\n            <!-- Features grid -->\r\n            <div class=\"features-grid\">\r\n\r\n                <!-- Feature 1: Browse & Learn -->\r\n                <div class=\"feature-card glass\">\r\n                    <div class=\"feature-icon\">\r\n                        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\r\n                            stroke-width=\"1.5\">\r\n                            <path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\" />\r\n                            <path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\" />\r\n                        </svg>\r\n                    </div>\r\n                    <h3 class=\"feature-title\">Browse & Learn</h3>\r\n                    <p class=\"feature-description\">\r\n                        Explore hundreds of projects built by vibecoders. See what's possible\r\n                        and get inspired for your own creations.\r\n                    </p>\r\n                </div>\r\n\r\n                <!-- Feature 2: Tools Guide -->\r\n                <div class=\"feature-card glass\">\r\n                    <div class=\"feature-icon\">\r\n                        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\r\n                            stroke-width=\"1.5\">\r\n                            <circle cx=\"12\" cy=\"12\" r=\"3\" />\r\n                            <path\r\n                                d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\" />\r\n                        </svg>\r\n                    </div>\r\n                    <h3 class=\"feature-title\">Tools Guide</h3>\r\n                    <p class=\"feature-description\">\r\n                        Curated list of AI tools, frameworks, and platforms. Know exactly\r\n                        which tools to use for your project.\r\n                    </p>\r\n                </div>\r\n\r\n                <!-- Feature 3: Vibecoder's Dictionary -->\r\n                <div class=\"feature-card glass\">\r\n                    <div class=\"feature-icon\">\r\n                        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"\r\n                            stroke-width=\"1.5\">\r\n                            <path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\" />\r\n                            <path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\" />\r\n                        </svg>\r\n                    </div>\r\n                    <h3 class=\"feature-title\">Vibecoder's Dictionary</h3>\r\n                    <p class=\"feature-description\">\r\n                        Learn the language. Every term you need to know, with AI prompts\r\n                        to help you implement them.\r\n                    </p>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         MODEL SECTION\r\n         How vibecoding works\r\n         ======================================== -->\r\n    <section class=\"section section-dark\">\r\n        <div class=\"container\">\r\n\r\n            <!-- Section header -->\r\n            <div class=\"section-header\">\r\n                <span class=\"section-tag\">How It Works</span>\r\n                <h2 class=\"section-title\">Build Without <span class=\"gradient-text\">Writing Code</span></h2>\r\n            </div>\r\n\r\n            <!-- Model grid -->\r\n            <div class=\"model-grid\">\r\n\r\n                <!-- Step 1 -->\r\n                <div class=\"model-card glass\">\r\n                    <span class=\"model-number\">01</span>\r\n                    <h3 class=\"model-title\">Describe Your Idea</h3>\r\n                    <p class=\"model-description\">\r\n                        Tell an AI what you want to build in plain English.\r\n                        <strong>\"Make me a task manager with categories and due dates.\"</strong>\r\n                    </p>\r\n                </div>\r\n\r\n                <!-- Step 2 -->\r\n                <div class=\"model-card glass\">\r\n                    <span class=\"model-number\">02</span>\r\n                    <h3 class=\"model-title\">AI Writes the Code</h3>\r\n                    <p class=\"model-description\">\r\n                        Claude, ChatGPT, or Cursor generates working code.\r\n                        <strong>You iterate by describing what to change.</strong>\r\n                    </p>\r\n                </div>\r\n\r\n                <!-- Step 3 -->\r\n                <div class=\"model-card glass\">\r\n                    <span class=\"model-number\">03</span>\r\n                    <h3 class=\"model-title\">Deploy & Share</h3>\r\n                    <p class=\"model-description\">\r\n                        Push to Vercel or Netlify with one click.\r\n                        <strong>Your app is live for the world to use.</strong>\r\n                    </p>\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         STATS SECTION\r\n         Key numbers\r\n         ======================================== -->\r\n    <section class=\"section\">\r\n        <div class=\"container\">\r\n            <div class=\"stats-grid\">\r\n\r\n                <div class=\"stat-item\">\r\n                    <div class=\"stat-value\">∞</div>\r\n                    <div class=\"stat-label\">Possibilities</div>\r\n                </div>\r\n\r\n                <div class=\"stat-item\">\r\n                    <div class=\"stat-value\">0</div>\r\n                    <div class=\"stat-label\">Code Experience Required</div>\r\n                </div>\r\n\r\n                <div class=\"stat-item\">\r\n                    <div class=\"stat-value\">1</div>\r\n                    <div class=\"stat-label\">Community</div>\r\n                </div>\r\n\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         JOIN SECTION\r\n         Call to action\r\n         ======================================== -->\r\n    <section class=\"section section-dark\">\r\n        <div class=\"container\">\r\n\r\n            <div class=\"join-card\">\r\n                <img src=\"assets/images/white-logo.svg\" alt=\"divisionzero\" class=\"join-logo\">\r\n                <h2 class=\"join-title\">Join <span class=\"gradient-text\">divisionzero</span></h2>\r\n                <p class=\"join-description\">\r\n                    Connect with vibecoders, share your projects, get feedback,\r\n                    and build together. The community is waiting for you.\r\n                </p>\r\n                <div class=\"join-cta\">\r\n                    <a href=\"https://discord.gg/SXJS4S7jUE\" target=\"_blank\" rel=\"noopener noreferrer\"\r\n                        class=\"btn-primary btn-large\">\r\n                        Join Discord\r\n                        <span class=\"btn-icon\">→</span>\r\n                    </a>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         VOCABULARY TERM ROWS\r\n         3 scrolling rows with tooltips\r\n         ======================================== -->\r\n    <section class=\"term-scroll-section section\">\r\n        <div class=\"container\">\r\n            <div class=\"section-header\">\r\n                <span class=\"section-tag\">Learn the Language</span>\r\n                <h2 class=\"section-title\">Vibecoder <span class=\"gradient-text\">Vocabulary</span></h2>\r\n            </div>\r\n        </div>\r\n        <div class=\"term-scroll-container\" id=\"term-scroll-container\">\r\n            <!-- Term rows rendered by JS -->\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         STACK LOGO LOOP\r\n         Infinite scrolling tool icons (decorative)\r\n         ======================================== -->\r\n    <section class=\"logo-scroll-section\">\r\n        <div class=\"container\">\r\n            <div class=\"section-header\" style=\"text-align: center;\">\r\n                <p class=\"section-description\" style=\"margin-bottom: 0;\">\r\n                    Built with the tools you love\r\n                </p>\r\n            </div>\r\n        </div>\r\n        <div class=\"logo-scroll-wrapper\">\r\n            <div class=\"logo-scroll-track\" id=\"logo-scroll-track\">\r\n                <!-- Logos rendered by JS -->\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         FOOTER\r\n         Rendered by JavaScript (footer.js)\r\n         ======================================== -->\r\n    \r\n\r\n\r\n    <!-- ========================================\r\n         JAVASCRIPT FILES\r\n         Load order: config → utils → components → pods → pages\r\n         ======================================== -->\r\n\r\n    <!-- Config & Utilities -->\r\n    \r\n    \r\n\r\n    <!-- Components -->\r\n    \r\n    \r\n\r\n    <!-- Pods -->\r\n    \r\n\r\n    <!-- Page Script -->\r\n    \r\n\r\n    <!-- Mobile Spotlight -->\n    </div>\n\n    <!-- PAGE: PROJECTS -->\n    <div id=\"page-projects\" class=\"spa-page \" style=\"display: none;\">\n        <!-- NAVIGATION -->\r\n    \r\n\r\n\r\n    <!-- ========================================\r\n         HERO SECTION\r\n         ======================================== -->\r\n    <section class=\"projects-hero\">\r\n        <div class=\"container\">\r\n            <div class=\"projects-header\">\r\n                <h1 class=\"projects-title\">\r\n                    <span class=\"gradient-text\">Vibecoding</span> Projects\r\n                </h1>\r\n                <p class=\"projects-subtitle\">\r\n                    Discover apps built by vibecoders using AI. Get inspired, learn from others,\r\n                    and share your own creations.\r\n                </p>\r\n                <a href=\"#\" id=\"full-projects-link\" class=\"hero-external-link\">\r\n                    For more projects →\r\n                </a>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         SEARCH & FILTERS\r\n         ======================================== -->\r\n    <section class=\"section\" style=\"padding-top: 0;\">\r\n        <div class=\"container\">\r\n\r\n            <!-- Search input -->\r\n            <div class=\"dictionary-controls\">\r\n                <input type=\"text\" id=\"project-search\" class=\"search-input\"\r\n                    placeholder=\"Search projects by name, description, or tech...\">\r\n            </div>\r\n\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         PROJECTS CONTAINER\r\n         Categories and carousels rendered here by JS\r\n         ======================================== -->\r\n    <section class=\"section\" style=\"padding-top: 0;\">\r\n        <div class=\"container-lg\" id=\"projects-container\">\r\n            <!-- Carousels inserted by projects.js -->\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- FOOTER -->\r\n    \r\n\r\n\r\n    <!-- JavaScript Files -->\r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n\r\n    <!-- Set external link from config -->\r\n    \r\n\r\n    <!-- Mobile Spotlight -->\n    </div>\n\n    <!-- PAGE: TOOLS -->\n    <div id=\"page-tools\" class=\"spa-page \" style=\"display: none;\">\n        <!-- NAVIGATION -->\r\n    \r\n\r\n\r\n    <!-- ========================================\r\n         HERO SECTION\r\n         ======================================== -->\r\n    <section class=\"tools-hero\">\r\n        <div class=\"container\">\r\n            <div class=\"tools-header-content\">\r\n                <h1 class=\"tools-main-title\">\r\n                    The <span class=\"gradient-text\">Vibecoder's</span> Toolkit\r\n                </h1>\r\n                <p class=\"tools-subtitle\">\r\n                    Everything you need to build apps without writing code.\r\n                    From AI assistants to deployment platforms.\r\n                </p>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         TOOLS CONTAINER\r\n         Categories and cards rendered here by JS\r\n         ======================================== -->\r\n    <section class=\"section\" style=\"padding-top: 0;\">\r\n        <div class=\"container\" id=\"tools-container\">\r\n            <!-- Tool categories inserted by tools.js -->\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- FOOTER -->\r\n    \r\n\r\n\r\n    <!-- JavaScript Files -->\r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n\r\n    <!-- Mobile Spotlight -->\n    </div>\n\n    <!-- PAGE: DICTIONARY -->\n    <div id=\"page-dictionary\" class=\"spa-page \" style=\"display: none;\">\n        <!-- NAVIGATION -->\r\n    \r\n\r\n\r\n    <!-- ========================================\r\n         HERO SECTION\r\n         ======================================== -->\r\n    <section class=\"dictionary-hero\">\r\n        <div class=\"container\">\r\n            <div class=\"section-header\">\r\n                <h1 class=\"section-title\">\r\n                    <span class=\"gradient-text\">Vibecoder's</span> Dictionary\r\n                </h1>\r\n                <p class=\"section-description\">\r\n                    Learn the language of modern web development.\r\n                    Every term comes with an AI prompt to help you implement it.\r\n                </p>\r\n                <a href=\"#\" id=\"full-library-link\" class=\"hero-external-link\">\r\n                    Our library →\r\n                </a>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         SEARCH\r\n         ======================================== -->\r\n    <section class=\"section\" style=\"padding-top: 0;\">\r\n        <div class=\"container\">\r\n            <div class=\"dictionary-controls\">\r\n                <input type=\"text\" id=\"term-search\" class=\"search-input\" placeholder=\"Search terms...\">\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         TERMS CONTAINER\r\n         Cards rendered here by JS\r\n         ======================================== -->\r\n    <section class=\"section\" style=\"padding-top: 0;\">\r\n        <div class=\"container\" id=\"terms-container\">\r\n            <!-- Term cards inserted by dictionary.js -->\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         TERM MODAL\r\n         Opened when clicking a term card\r\n         ======================================== -->\r\n    <div class=\"modal term-modal\" id=\"term-modal\">\r\n        <div class=\"modal-backdrop\"></div>\r\n        <div class=\"modal-content glass\">\r\n            <!-- Content inserted by dictionary.js -->\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!-- FOOTER -->\r\n    \r\n\r\n\r\n    <!-- JavaScript Files -->\r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n\r\n    <!-- Set external link from config -->\r\n    \r\n\r\n    <!-- Mobile Spotlight -->\n    </div>\n\n    <!-- PAGE: SUBMIT -->\n    <div id=\"page-submit\" class=\"spa-page \" style=\"display: none;\">\n        <!-- NAVIGATION -->\r\n    \r\n\r\n\r\n    <!-- ========================================\r\n         HERO SECTION\r\n         ======================================== -->\r\n    <section class=\"submit-hero\">\r\n        <div class=\"container\">\r\n            <div class=\"submit-header\">\r\n                <h1 class=\"submit-title\">\r\n                    Share Your <span class=\"gradient-text\">Creation</span>\r\n                </h1>\r\n                <p class=\"submit-subtitle\">\r\n                    Built something cool? Have an idea for the community?\r\n                    We'd love to hear from you.\r\n                </p>\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- ========================================\r\n         FORM SECTION\r\n         ======================================== -->\r\n    <section class=\"section\" style=\"padding-top: 0;\">\r\n        <div class=\"container\">\r\n            <div class=\"form-container\">\r\n\r\n                <!-- FORM TOGGLE -->\r\n                <div class=\"form-toggle\">\r\n                    <button type=\"button\" class=\"toggle-btn active\" data-form=\"project\">\r\n                        Submit Project\r\n                    </button>\r\n                    <button type=\"button\" class=\"toggle-btn\" data-form=\"idea\">\r\n                        Submit Idea\r\n                    </button>\r\n                </div>\r\n\r\n\r\n                <!-- ========================================\r\n                     PROJECT FORM\r\n                     ======================================== -->\r\n                <form id=\"project-form\" class=\"form-card glass\">\r\n\r\n                    <div class=\"form-header\">\r\n                        <h2>Submit Your Project</h2>\r\n                        <p>Share your vibecoding creation with the community</p>\r\n                    </div>\r\n\r\n                    <!-- BASIC INFO SECTION -->\r\n                    <div class=\"form-section\">\r\n                        <h3 class=\"form-section-title\">Basic Information</h3>\r\n\r\n                        <div class=\"form-row\">\r\n                            <div class=\"form-group\">\r\n                                <label for=\"project-name\">Project Name *</label>\r\n                                <input type=\"text\" id=\"project-name\" name=\"name\" required maxlength=\"20\"\r\n                                    placeholder=\"e.g., TaskFlow Pro\">\r\n                            </div>\r\n\r\n                            <div class=\"form-group\">\r\n                                <label for=\"project-url\">Live URL *</label>\r\n                                <input type=\"url\" id=\"project-url\" name=\"url\" required\r\n                                    placeholder=\"https://your-app.vercel.app\">\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"form-group\">\r\n                            <label for=\"project-description\">Description *</label>\r\n                            <textarea id=\"project-description\" name=\"description\" required maxlength=\"90\"\r\n                                placeholder=\"What does your project do? What problem does it solve?\"></textarea>\r\n                        </div>\r\n\r\n                        <div class=\"form-group\">\r\n                            <label for=\"project-logo\">Logo (ImgBB HTML) *</label><textarea id=\"project-logo\" name=\"logo\" required rows=\"2\" placeholder=\"Paste full HTML from ImgBB: <a href=...><img src=...></a>\"></textarea><span class=\"form-hint\">Upload to imgbb.com ? Copy \"HTML full linked\" ? Paste here</span>\r\n                        </div>\r\n                    </div>\r\n                    <!-- BUILDER INFO ROW -->\r\n                    <div class=\"form-row\">\r\n                        <div class=\"form-group\">\r\n                            <label for=\"builder-name\">Your Username / Handle *</label>\r\n                            <input type=\"text\" id=\"builder-name\" name=\"builderName\" required placeholder=\"vibecoder1\">\r\n                            <span class=\"form-hint\">This will show as @username on your project card</span>\r\n                        </div>\r\n                    </div>\r\n                    <!-- LINKS SECTION -->\r\n                    <div class=\"form-section\">\r\n                        <h3 class=\"form-section-title\">Links (Optional)</h3>\r\n\r\n                        <div class=\"form-row\">\r\n                            <div class=\"form-group\">\r\n                                <label for=\"project-github\">GitHub Repository</label>\r\n                                <input type=\"url\" id=\"project-github\" name=\"github\"\r\n                                    placeholder=\"https://github.com/you/repo\">\r\n                            </div>\r\n\r\n                            <div class=\"form-group\">\r\n                                <label for=\"project-discord\">Your Discord Username</label>\r\n                                <input type=\"text\" id=\"project-discord\" name=\"discord\"\r\n                                    placeholder=\"username#1234 or @username\">\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"form-group\">\r\n                            <label for=\"project-profile\">Personal Profile URL</label>\r\n                            <input type=\"url\" id=\"project-profile\" name=\"profileUrl\"\r\n                                placeholder=\"https://linkedin.com/in/yourname or https://yourwebsite.com\">\r\n                            <span class=\"form-hint\">LinkedIn, personal website, or portfolio link</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- TECH SECTION -->\r\n                    <div class=\"form-section\">\r\n                        <h3 class=\"form-section-title\">Technology</h3>\r\n\r\n                        <div class=\"form-group\">\r\n                            <label>AI Tools Used</label>\r\n                            <div class=\"tile-grid\" data-max-select=\"5\" data-input-name=\"tools\">\r\n                                <div class=\"tile\" data-value=\"Claude\">Claude</div>\r\n                                <div class=\"tile\" data-value=\"ChatGPT\">ChatGPT</div>\r\n                                <div class=\"tile\" data-value=\"Gemini\">Gemini</div>\r\n                                <div class=\"tile\" data-value=\"Cursor\">Cursor</div>\r\n                                <div class=\"tile\" data-value=\"v0.dev\">v0.dev</div>\r\n                                <div class=\"tile\" data-value=\"Bolt.new\">Bolt.new</div>\r\n                                <div class=\"tile\" data-value=\"Lovable\">Lovable</div>\r\n                                <div class=\"tile\" data-value=\"Replit\">Replit</div>\r\n                            </div>\r\n                            <input type=\"hidden\" name=\"tools\" value=\"\">\r\n                            <span class=\"form-hint\">Select up to 5</span>\r\n                        </div>\r\n\r\n                        <div class=\"form-group\">\r\n                            <label>Tech Stack</label>\r\n                            <div class=\"tile-grid\" data-max-select=\"5\" data-input-name=\"tags\">\r\n                                <div class=\"tile\" data-value=\"React\">React</div>\r\n                                <div class=\"tile\" data-value=\"Next.js\">Next.js</div>\r\n                                <div class=\"tile\" data-value=\"Vue.js\">Vue.js</div>\r\n                                <div class=\"tile\" data-value=\"TypeScript\">TypeScript</div>\r\n                                <div class=\"tile\" data-value=\"JavaScript\">JavaScript</div>\r\n                                <div class=\"tile\" data-value=\"Node.js\">Node.js</div>\r\n                                <div class=\"tile\" data-value=\"Python\">Python</div>\r\n                                <div class=\"tile\" data-value=\"Supabase\">Supabase</div>\r\n                                <div class=\"tile\" data-value=\"Firebase\">Firebase</div>\r\n                                <div class=\"tile\" data-value=\"MongoDB\">MongoDB</div>\r\n                                <div class=\"tile\" data-value=\"PostgreSQL\">PostgreSQL</div>\r\n                                <div class=\"tile\" data-value=\"TailwindCSS\">TailwindCSS</div>\r\n                            </div>\r\n                            <input type=\"hidden\" name=\"tags\" value=\"\">\r\n                            <span class=\"form-hint\">Select up to 5</span>\r\n                        </div>\r\n\r\n                        <div class=\"form-group\">\r\n                            <label for=\"project-category\">Category *</label>\r\n                            <select id=\"project-category\" name=\"category\" required>\r\n                                <option value=\"\">Select a category</option>\r\n                                <option value=\"Productivity\">Productivity</option>\r\n                                <option value=\"Developer Tools\">Developer Tools</option>\r\n                                <option value=\"Design\">Design</option>\r\n                                <option value=\"Games\">Games</option>\r\n                                <option value=\"AI Agents\">AI Agents</option>\r\n                                <option value=\"Utilities\">Utilities</option>\r\n                                <option value=\"Other\">Other</option>\r\n                            </select>\r\n                        </div>\r\n                    </div>\r\n                    <!-- PRICING MODEL -->\r\n                    <div class=\"form-group\">\r\n                        <label for=\"project-pricing\">Pricing Model *</label>\r\n                        <select id=\"project-pricing\" name=\"pricingModel\" required>\r\n                            <option value=\"\">Select pricing model</option>\r\n                            <option value=\"free\">Completely Free (all tools have free tier)</option>\r\n                            <option value=\"partial\">Partially Paid (mix of free and paid tools)</option>\r\n                            <option value=\"paid\">Fully Paid (no free tier available)</option>\r\n                        </select>\r\n                        <span class=\"form-hint\">This helps users know if they need paid subscriptions to recreate\r\n                            this</span>\r\n                    </div>\r\n\r\n                    <!-- SUBMIT -->\r\n                    <button type=\"submit\" class=\"btn-submit\">\r\n                        Submit Project\r\n                    </button>\r\n\r\n                </form>\r\n\r\n\r\n                <!-- ========================================\r\n                     IDEA FORM\r\n                     ======================================== -->\r\n                <form id=\"idea-form\" class=\"form-card glass hidden\">\r\n\r\n                    <div class=\"form-header\">\r\n                        <h2>Submit an Idea</h2>\r\n                        <p>Got an idea for the community? Let us know!</p>\r\n                    </div>\r\n\r\n                    <div class=\"form-section\">\r\n\r\n                        <!-- Contact Information -->\r\n                        <div class=\"form-row\">\r\n                            <div class=\"form-group\">\r\n                                <label for=\"idea-name\">Your Name *</label>\r\n                                <input type=\"text\" id=\"idea-name\" name=\"name\" required placeholder=\"John Doe\">\r\n                            </div>\r\n\r\n                            <div class=\"form-group\">\r\n                                <label for=\"idea-email\">Email *</label>\r\n                                <input type=\"email\" id=\"idea-email\" name=\"email\" required\r\n                                    placeholder=\"john@example.com\">\r\n                                <span class=\"form-hint\">We'll use this to contact you</span>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <!-- Idea Title -->\r\n                        <div class=\"form-group\">\r\n                            <label for=\"idea-title\">Idea Title *</label>\r\n                            <input type=\"text\" id=\"idea-title\" name=\"title\" required\r\n                                placeholder=\"e.g., AI-powered task manager\">\r\n                        </div>\r\n\r\n                        <!-- Category -->\r\n                        <div class=\"form-group\">\r\n                            <label for=\"idea-category\">Category</label>\r\n                            <select id=\"idea-category\" name=\"category\">\r\n                                <option value=\"\">Select category</option>\r\n                                <option value=\"app\">App</option>\r\n                                <option value=\"game\">Game</option>\r\n                                <option value=\"tool\">Tool</option>\r\n                                <option value=\"website\">Website</option>\r\n                                <option value=\"extension\">Extension</option>\r\n                                <option value=\"bot\">Bot</option>\r\n                                <option value=\"other\">Other</option>\r\n                            </select>\r\n                        </div>\r\n\r\n                        <!-- Docs Link -->\r\n                        <div class=\"form-group\">\r\n                            <label for=\"idea-docs\">Idea Document Link *</label>\r\n                            <input type=\"url\" id=\"idea-docs\" name=\"docsLink\" required\r\n                                placeholder=\"https://docs.google.com/document/d/...\">\r\n                            <span class=\"form-hint\">Paste your Google Docs, Notion, or any document link with your idea\r\n                                details</span>\r\n                        </div>\r\n\r\n                        <!-- Purpose -->\r\n                        <div class=\"form-group\">\r\n                            <label for=\"idea-purpose\">Purpose of Submission *</label>\r\n                            <select id=\"idea-purpose\" name=\"purpose\" required>\r\n                                <option value=\"\">Select purpose</option>\r\n                                <option value=\"validation\">Just for Validation / Feedback</option>\r\n                                <option value=\"client\">I'm a Client (Looking to build this)</option>\r\n                            </select>\r\n                        </div>\r\n\r\n                        <!-- Budget (shown only when purpose is \"client\") -->\r\n                        <div class=\"form-group budget-group hidden\">\r\n                            <label for=\"idea-budget\">Budget (USD) *</label>\r\n                            <div class=\"budget-input-wrapper\">\r\n                                <span class=\"budget-currency\">$</span>\r\n                                <input type=\"number\" id=\"idea-budget\" name=\"budget\" min=\"0\"\r\n                                    placeholder=\"Enter your budget\">\r\n                            </div>\r\n                            <span class=\"form-hint\">Your approximate budget for this project</span>\r\n                        </div>\r\n\r\n                    </div>\r\n\r\n                    <button type=\"submit\" class=\"btn-submit\">\r\n                        Submit Idea\r\n                    </button>\r\n\r\n                </form>\r\n\r\n            </div>\r\n        </div>\r\n    </section>\r\n\r\n\r\n    <!-- FOOTER -->\r\n    \r\n\r\n\r\n    <!-- JavaScript Files -->\r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n\r\n    <!-- Mobile Spotlight -->\n    </div>\n\n    </main>\n\n    <!-- FOOTER (global) -->\n    <div id=\"footer-placeholder\"></div>\n\n    <!-- JS Bundle -->\n    <script src=\"app.min.js\"></script>\n\n    <!-- Service Worker -->\n    <script>\n        if ('serviceWorker' in navigator) {\n            window.addEventListener('load', () => {\n                navigator.serviceWorker.register('/sw.js')\n                    .then(reg => console.log('SW registered'))\n                    .catch(err => console.log('SW error:', err));\n            });\n        }\n    </script>\n</body>\n</html>"
