            "text": ":root{--color-bg-dark: #0a0a0f;--color-bg-secondary: #13131a;--color-bg-tertiary: #1a1a24;--color-primary: #8b5cf6;--color-primary-dark: #7c3aed;--color-primary-light: #a78bfa;--color-accent: #06b6d4;--color-accent-glow: rgba(6, 182, 212, .3);--color-text-primary: #ffffff;--color-text-secondary: #a1a1aa;--color-text-tertiary: #71717a;--color-success: #10b981;--color-warning: #f59e0b;--color-error: #ef4444;--gradient-primary: linear-gradient(135deg, #8b5cf6 0%, #06b6d4 100%);--gradient-glow: radial-gradient(circle at 50% 0%, rgba(139, 92, 246, .15), transparent 50%);--gradient-card-hover: linear-gradient(135deg, rgba(139, 92, 246, .1) 0%, rgba(6, 182, 212, .1) 100%);--spacing-xs: .5rem;--spacing-sm: 1rem;--spacing-md: 1.5rem;--spacing-lg: 2rem;--spacing-xl: 3rem;--spacing-2xl: 4rem;--spacing-3xl: 6rem;--font-primary: \"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;--font-display: \"Space Grotesk\", var(--font-primary);--text-xs: .75rem;--text-sm: .875rem;--text-base: 1rem;--text-lg: 1.125rem;--text-xl: 1.25rem;--text-2xl: 1.5rem;--text-3xl: 2rem;--text-4xl: 2.5rem;--text-5xl: 3.5rem;--radius-sm: .5rem;--radius-md: 1rem;--radius-lg: 1.5rem;--radius-full: 9999px;--shadow-sm: 0 2px 4px rgba(0, 0, 0, .1);--shadow-md: 0 4px 12px rgba(0, 0, 0, .15);--shadow-lg: 0 8px 24px rgba(0, 0, 0, .2);--shadow-glow: 0 4px 20px rgba(139, 92, 246, .3);--shadow-glow-hover: 0 6px 30px rgba(139, 92, 246, .5);--transition-fast: .15s cubic-bezier(.4, 0, .2, 1);--transition-base: .3s cubic-bezier(.4, 0, .2, 1);--transition-slow: .5s cubic-bezier(.4, 0, .2, 1);--z-base: 0;--z-dropdown: 100;--z-sticky: 200;--z-nav: 1000;--z-modal-backdrop: 1500;--z-modal: 2000;--z-toast: 3000;--max-width-sm: 640px;--max-width-md: 768px;--max-width-lg: 1024px;--max-width-xl: 1200px;--max-width-2xl: 1400px}*,*:before,*:after{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}body{min-height:100vh;line-height:1.6;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;overflow-x:hidden}img,picture,video,canvas,svg{display:block;max-width:100%;height:auto}input,button,textarea,select{font:inherit;color:inherit}ul,ol{list-style:none}a{text-decoration:none;color:inherit}button{background:none;border:none;cursor:pointer}table{border-collapse:collapse;border-spacing:0}:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}:focus:not(:focus-visible){outline:none}::selection{background:var(--color-primary);color:var(--color-text-primary)}body{font-family:var(--font-primary);font-size:var(--text-base);color:var(--color-text-primary);background-color:var(--color-bg-dark)}h1{font-family:var(--font-display);font-size:clamp(2.5rem,8vw,5rem);font-weight:700;line-height:1.1}h2{font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);font-weight:700;line-height:1.2}h3{font-family:var(--font-display);font-size:var(--text-2xl);font-weight:700;line-height:1.3}h4{font-family:var(--font-display);font-size:var(--text-xl);font-weight:600;line-height:1.4}h5{font-family:var(--font-primary);font-size:var(--text-lg);font-weight:600;line-height:1.4}h6{font-family:var(--font-primary);font-size:var(--text-base);font-weight:600;line-height:1.5}p{margin-bottom:var(--spacing-sm);line-height:1.7}.text-lead{font-size:clamp(1.1rem,2vw,1.3rem);color:var(--color-text-secondary);line-height:1.8}.text-small{font-size:var(--text-sm);color:var(--color-text-tertiary)}.text-muted{color:var(--color-text-secondary)}a{color:var(--color-primary-light);transition:color var(--transition-fast)}a:hover{color:var(--color-primary)}.font-light{font-weight:300}.font-normal{font-weight:400}.font-medium{font-weight:500}.font-semibold{font-weight:600}.font-bold{font-weight:700}.uppercase{text-transform:uppercase;letter-spacing:.05em}.capitalize{text-transform:capitalize}.text-left{text-align:left}.text-center{text-align:center}.text-right{text-align:right}.truncate{overflow:hidden;text-overflow:ellipsis