{
    "_schema_version": "1.0",
    "_description": "Schema for PAID idea commissions - client pays to have idea built",
    "_flow": {
        "1_submit": "Client submits idea via paid form",
        "2_webhook": "Form triggers paid webhook",
        "3_bot_saves_sheet": "Bot saves to Google Sheet (leads/clients sheet)",
        "4_bot_notifies_owner": "Bot sends DM/notification to owner",
        "5_owner_validates": "Owner reaches out via email to validate and negotiate",
        "6_owner_shares": "If deal confirmed, owner shares in private builder groups",
        "7_builder_claims": "Interested builder claims the project",
        "8_payment_split": "Builder receives 85%, platform takes 15%"
    },
    "paid_idea": {
        "// ============================================": "",
        "// SECTION 1: CLIENT SUBMITTED (via form)": "",
        "// ============================================": "",
        "clientName": "Client's Full Name",
        "clientEmail": "client@email.com",
        "discordId": "@optional_discord_username",
        "ideaTitle": "Short title for the project",
        "ideaDescription": "Brief description of what they want built",
        "ideaDocLink": "https://docs.google.com/... or notion link",
        "_ideaDocLink_note": "Detailed requirements, mockups, specs",
        "category": "App | Game | Tool | Website | Extension | Bot | Other",
        "budgetRange": "Under $100 | $100-500 | $500-1000 | $1000-5000 | $5000+",
        "timeline": "ASAP | 1-2 weeks | 1 month | Flexible",
        "additionalNotes": "Any other details client wants to share",
        "// ============================================": "",
        "// SECTION 2: BOT GENERATED (automated)": "",
        "// ============================================": "",
        "id": "paid_auto_generated_id",
        "submittedAt": "2024-12-11T00:00:00Z",
        "googleSheetRow": 42,
        "ownerNotified": true,
        "ownerNotifiedAt": "2024-12-11T00:00:00Z",
        "// ============================================": "",
        "// SECTION 3: OWNER MANAGED (manual)": "",
        "// ============================================": "",
        "status": "new | contacted | negotiating | confirmed | assigned | in_progress | completed | cancelled",
        "ownerNotes": "Internal notes from validation/negotiation",
        "emailSentAt": "2024-12-11T00:00:00Z",
        "agreedPrice": 0,
        "sharedToBuilders": false,
        "sharedAt": null,
        "// ============================================": "",
        "// SECTION 4: BUILDER ASSIGNMENT": "",
        "// ============================================": "",
        "assignedBuilder": {
            "name": "Builder Name",
            "discordId": "@builder_discord",
            "email": "builder@email.com"
        },
        "assignedAt": null,
        "builderShare": 0.85,
        "_builderShare_note": "85% goes to builder, 15% to platform",
        "platformShare": 0.15,
        "// ============================================": "",
        "// SECTION 5: COMPLETION": "",
        "// ============================================": "",
        "deliverables": {
            "projectUrl": null,
            "githubRepo": null,
            "handoffDate": null
        },
        "clientSatisfied": null,
        "paymentReceived": false,
        "paymentReceivedAt": null,
        "builderPaid": false,
        "builderPaidAt": null
    },
    "_webhook_config": {
        "endpoint": "PAID_IDEA_WEBHOOK_URL",
        "method": "POST",
        "payload_includes": [
            "clientName",
            "clientEmail",
            "discordId",
            "ideaTitle",
            "ideaDescription",
            "ideaDocLink",
            "category",
            "budgetRange",
            "timeline",
            "additionalNotes"
        ]
    },
    "_discord_bot_actions": [
        "1. Receive webhook payload",
        "2. Save to Google Sheet (Paid Leads tab)",
        "3. Send DM to owner with client details",
        "4. That's it - rest is manual"
    ],
    "_google_sheet_columns": [
        "ID",
        "Timestamp",
        "Client Name",
        "Client Email",
        "Discord ID",
        "Idea Title",
        "Description",
        "Doc Link",
        "Category",
        "Budget Range",
        "Timeline",
        "Additional Notes",
        "Status",
        "Owner Notes",
        "Agreed Price",
        "Assigned Builder",
        "Builder Email",
        "Completed",
        "Payment Status"
    ],
    "_payment_flow": {
        "1": "Client pays agreed amount to platform",
        "2": "Platform confirms payment received",
        "3": "Builder completes the project",
        "4": "Client confirms satisfaction",
        "5": "Platform pays 85% to builder",
        "6": "Platform keeps 15% commission"
    }
}