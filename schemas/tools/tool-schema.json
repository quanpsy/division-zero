{
    "_schema_version": "1.1",
    "_description": "Simplified schema for curated vibecoding tools",
    "_note": "Minimal fields only. No 7 in difficulty or capability ratings (Division Zero pun)!",
    "tool": {
        "// ============================================": "",
        "// CORE INFO": "",
        "// ============================================": "",
        "id": "tool-slug",
        "name": "Tool Name",
        "icon": "https://cdn.jsdelivr.net/... or local SVG path",
        "website": "https://official-website.com",
        "description": "One-line description of what this tool does",
        "category": "ai_chatbots | code_editors | no_code_builders | frontend | backend | database | hosting | design | utilities",
        "// ============================================": "",
        "// RATINGS (1-10, NO 7!)": "",
        "// ============================================": "",
        "difficulty": 5,
        "_difficulty_note": "1 = easiest, 10 = hardest. NO 7 ALLOWED!",
        "capability": 8,
        "_capability_note": "1 = small projects, 10 = enterprise scale. NO 7 ALLOWED!",
        "// ============================================": "",
        "// FLAGS": "",
        "// ============================================": "",
        "free_tier": true,
        "no_code_friendly": false
    },
    "_categories": [
        "ai_chatbots",
        "code_editors",
        "no_code_builders",
        "frontend",
        "backend",
        "database",
        "hosting",
        "design",
        "utilities"
    ],
    "_required_fields": [
        "id",
        "name",
        "icon",
        "website",
        "description",
        "category",
        "difficulty",
        "capability",
        "free_tier"
    ],
    "_optional_fields": [
        "no_code_friendly"
    ]
}